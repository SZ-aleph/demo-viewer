{
  "_metadata": {
    "description": "Contains scaling information for mapping 3D in-game world coordinates to 2D radar image pixels. The resulting radar_x and radar_y values are the exact pixel coordinates for a 1024x1024 image.",
    "formulas": {
      "radar_x": "(in_game_x - pos_x) / scale",
      "radar_y": "(pos_y - in_game_y) / scale",
      "note": "The Y-axis is inverted. To use with a different resolution, multiply the result by (your_resolution / 1024)."
    }
  },
